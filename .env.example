# tandem configuration — copy to .env and fill in. NEVER commit your real .env.
# setup.sh generates TANDEM_TOKEN for you automatically.

# REQUIRED. Shared secret. Every request must present this exact value.
# Generate one with:  openssl rand -hex 32
TANDEM_TOKEN=

# REQUIRED for real use. Colon-separated absolute paths the bridge may operate in.
# Sessions/relays can only be opened inside these directories (or subdirectories).
# If left empty the engine defaults to $HOME and its immediate child directories.
# Example: TANDEM_CWD_ALLOWLIST=/Users/you/code:/Users/you/projects
TANDEM_CWD_ALLOWLIST=

# Optional. Default working directory when a tool call omits cwd (default $HOME).
TANDEM_DEFAULT_CWD=

# Optional. Spawn claude in skip-permissions (autonomous) mode so turns don't stall
# on allow-prompts. DEFAULT ON. Set to 0/false/no/off to require normal prompts.
# This only suppresses in-session tool prompts; the cwd allowlist is still enforced
# BEFORE every spawn, so it never widens which directories are reachable.
TANDEM_SKIP_PERMISSIONS=1

# Local bind address/port the bridge listens on (the quick tunnel points here).
TANDEM_HOST=127.0.0.1
TANDEM_PORT=8787

# Optional. Bounded wait (ms) for a single send_to_session turn before it returns
# status:"running" so the caller can call again. Default 25000.
TANDEM_WAIT_MS=25000

# Optional. If set, every completion event (turn/relay done) is POSTed here as
# JSON, in addition to being appended to ~/.tandem/events.log.
TANDEM_DONE_WEBHOOK=

# Optional. ntfy topic to push a phone notification to when a session finishes.
# Leave blank to disable. Pick a long, hard-to-guess topic (anyone who knows it
# can read/post to it). Install the ntfy app, subscribe to this topic, set it here.
TANDEM_NTFY_TOPIC=

# Optional. ntfy server base URL (default https://ntfy.sh). Set only if self-hosted.
TANDEM_NTFY_SERVER=
