# Tandem manual/development configuration.
# Normal installations use `./setup.sh hub|device|desktop`, which writes
# protected JSON and secret files below ~/.tandem instead of this repository.
# Never commit a real .env.

# REQUIRED FOR SESSIONS. Colon-separated absolute start directories.
# Empty fails closed. This is an admission gate, not an OS filesystem sandbox.
TANDEM_CWD_ALLOWLIST=

# Optional default admitted cwd. Defaults to the first allowlist root.
TANDEM_DEFAULT_CWD=

# Claude is enabled by default. Add deliberate extras only: codex,shell,hermes.
# Shell is arbitrary command execution as the Tandem OS user.
TANDEM_ENABLED_ENGINES=

# Interactive runtime backend. `tmux` preserves upstream behavior. `herdr`
# drives one persistent Herdr session through its local socket API.
TANDEM_TERMINAL_BACKEND=tmux
TANDEM_HERDR_BIN=
# Named Herdr session for Tandem's agents. Defaults to `tandem`: its own
# session, started silently, so Herdr's toasts and sounds keep meaning "a pane
# YOU are watching needs you". Set `default` to share the personal session
# instead — Tandem then never starts or configures it, and its notifications
# apply to Tandem's agents too.
TANDEM_HERDR_SESSION=tandem
# Tandem-owned Herdr config for that session, written by Tandem and never the
# personal ~/.config/herdr/config.toml. Defaults to
# ~/.tandem/herdr/<session>.toml.
TANDEM_HERDR_CONFIG=
# Exact 0 stops Tandem creating/starting/configuring its session: it must then
# already be running, exactly as its operator started it.
TANDEM_HERDR_MANAGED_SESSION=
# Optional exact socket override; normally discovered from `herdr session list`.
TANDEM_HERDR_SOCKET=
# Optional PATH for Tandem-owned Herdr workspaces. Every entry must be absolute.
TANDEM_HERDR_WORKSPACE_PATH=

# Exact 1 enables Claude --dangerously-skip-permissions. Default off.
# Required only by the unattended Claude relay.
TANDEM_ALLOW_BYPASS=

# Public OAuth/MCP listener. The source listener must remain loopback.
TANDEM_HOST=127.0.0.1
TANDEM_PORT=8787

# REQUIRED for the production OAuth listener. Exact stable HTTPS resource URL.
# Use a synthetic value in examples, never commit a real tailnet name.
TANDEM_PUBLIC_URL=https://tandem-node.example.ts.net/mcp

# Required only while creating OAuth state. Prefer an owner-only file.
TANDEM_OWNER_PASSWORD_FILE=
TANDEM_OAUTH_STATE_DIR=

# Optional OAuth lifetimes in seconds. Defaults: access 600, refresh 2592000.
TANDEM_ACCESS_TTL_SECONDS=
TANDEM_REFRESH_TTL_SECONDS=

# HUB ONLY. Separate permanent fleet credential. Setting it opens the separate
# private loopback listener. Generate at least 32 random bytes.
TANDEM_FLEET_TOKEN=
TANDEM_FLEET_HOST=127.0.0.1
TANDEM_FLEET_PORT=8788

# Setup-only, tailnet-only Tailscale Serve HTTPS port. Must differ from 443.
TANDEM_FLEET_HTTPS_PORT=8443

# Protected invitation digest directory used by the hub.
TANDEM_ENROLLMENT_STATE_DIR=

# Preferred device when an open would otherwise be ambiguous. `local` is hub.
TANDEM_DEFAULT_DEVICE=

# DEVICE ONLY. Private Tailscale Serve URL and neutral identity.
TANDEM_HUB_URL=
TANDEM_DEVICE_ID=
TANDEM_DEVICE_NAME=

# HERMES ONLY. Hermes must be explicitly enabled above. The gateway must be an
# exact loopback URL without credentials, query, or fragment.
TANDEM_HERMES_BASE_URL=

# Colon-separated writable agent ids. Empty denies all Hermes attachment.
TANDEM_HERMES_WRITABLE_AGENTS=

# Optional bounded Hermes controls.
TANDEM_HERMES_TIMEOUT_MS=15000
TANDEM_HERMES_MAX_RESPONSE_BYTES=262144
TANDEM_HERMES_PASSWORD_PATH=
TANDEM_HERMES_DISABLE_LIVE=

# Bounded wait for send_to_session before returning status `running`.
TANDEM_WAIT_MS=25000

# Optional completion outputs. These can carry private summaries by design.
TANDEM_DONE_WEBHOOK=
TANDEM_NTFY_TOPIC=
TANDEM_NTFY_CLICK_URL=
TANDEM_NTFY_SERVER=

# MIGRATION ONLY. Exact 1 switches public HTTP from OAuth to a static bearer
# header. Query and path tokens remain disabled. New setups must leave this off.
TANDEM_LEGACY_TOKEN_AUTH=
TANDEM_TOKEN=
